<?xml version="1.0" encoding="UTF-8"?>
<!-- WPS 功能区配置：注册 BOM导入标签页，并将点击事件交给 ribbon.js。 -->
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnAddinLoad">
  <ribbon startFromScratch="false">
    <tabs>
      <tab id="fieldMappingTab" label="BOM导入">
        <group id="fieldMappingGroup" label="BOM导入">
          <button id="btnShowMappingPane" label="打开BOM导入" onAction="OnAction" getEnabled="OnGetEnabled" getImage="GetImage" size="large"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
